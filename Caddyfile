# HTTPS 인증서를 자동으로 받고 갱신한다 (DOMAIN은 루트 .env, 예: anomie-dev.duckdns.org).
# 80·443 포트가 열려 있고 도메인이 이 서버의 탄력적 IP를 가리켜야 발급된다.
{$DOMAIN} {
	encode gzip
	reverse_proxy server:3000

	# 모든 요청을 한 줄씩 남긴다 (경로·상태 코드·걸린 시간). 앱에서 실패했는데 서버 로그가 비어 있을 때,
	# 요청이 여기까지 왔는지부터 볼 수 있다 (11-05). Authorization 같은 인증 헤더 값은 Caddy가 기본으로 가린다.
	# 보기: docker compose -f docker-compose.prod.yml logs caddy | grep handled
	log {
		output stdout
		format console
	}
}
