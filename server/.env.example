# 이 파일을 .env로 복사한 뒤 값을 채운다 (.env는 커밋하지 않는다)
# DB 주소는 루트 docker-compose.yml(사용자 anomie / 비밀번호 1234 / 포트 5433)과 맞춘다
DATABASE_URL=postgresql://anomie:1234@localhost:5433/anomie
JWT_SECRET=아무_긴_임의_문자열
ANTHROPIC_API_KEY=
GOOGLE_VISION_API_KEY=

# 선택
# PORT=3000
# CORS_ORIGINS=http://localhost:5555
# TRUST_PROXY=1
